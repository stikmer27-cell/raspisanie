<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Расписание». Тексты здесь — пример для превью; настоящие подставляет WidgetUpdater. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/w_emblem"
            android:layout_width="20dp"
            android:layout_height="26dp"
            android:contentDescription="ВКИ НГУ"
            android:src="@drawable/ic_emblem" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="ВКИ НГУ · 2401а1"
                android:textColor="#2F6FE0"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Сегодня, чт 1 октября"
                android:textColor="#121826"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/w_sum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:text="4 пары"
            android:textColor="#667085"
            android:textSize="12sp" />
        <ImageView
            android:id="@+id/w_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Обновить"
            android:padding="7dp"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:background="@drawable/widget_pill_now_light"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="9dp"
        android:paddingTop="3dp"
        android:paddingEnd="9dp"
        android:paddingBottom="3dp"
        android:text="Сейчас 2 пара · ещё 40 мин"
        android:textColor="#12A150"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/w_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/r1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:visibility="visible">
            <TextView
                android:id="@+id/r1_num"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_badge_light"
                android:gravity="center"
                android:text="1"
                android:textColor="#2F6FE0"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/r1_time"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:fontFeatureSettings="tnum"
                android:text="09:00"
                android:textColor="#667085"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/r1_subj"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="История"
                android:textColor="#121826"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/r1_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="Чит. зал"
                android:textColor="#667085"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/r2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/widget_row_now_light"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:visibility="visible">
            <TextView
                android:id="@+id/r2_num"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_badge_now"
                android:gravity="center"
                android:text="2"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/r2_time"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:fontFeatureSettings="tnum"
                android:text="10:45"
                android:textColor="#667085"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/r2_subj"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Математика"
                android:textColor="#121826"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/r2_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="Чит. зал"
                android:textColor="#667085"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/r3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:visibility="visible">
            <TextView
                android:id="@+id/r3_num"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_badge_light"
                android:gravity="center"
                android:text="3"
                android:textColor="#2F6FE0"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/r3_time"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:fontFeatureSettings="tnum"
                android:text="13:00"
                android:textColor="#667085"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/r3_subj"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Обществознание"
                android:textColor="#121826"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/r3_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="111"
                android:textColor="#667085"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/r4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:visibility="visible">
            <TextView
                android:id="@+id/r4_num"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_badge_light"
                android:gravity="center"
                android:text="4"
                android:textColor="#2F6FE0"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/r4_time"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:fontFeatureSettings="tnum"
                android:text="14:45"
                android:textColor="#667085"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/r4_subj"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Физкультура"
                android:textColor="#121826"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/r4_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text=""
                android:textColor="#667085"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/r5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/r5_num"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_badge_light"
                android:gravity="center"
                android:text=""
                android:textColor="#2F6FE0"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/r5_time"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:fontFeatureSettings="tnum"
                android:text=""
                android:textColor="#667085"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/r5_subj"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#121826"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/r5_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text=""
                android:textColor="#667085"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/r6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/r6_num"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_badge_light"
                android:gravity="center"
                android:text=""
                android:textColor="#2F6FE0"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/r6_time"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:fontFeatureSettings="tnum"
                android:text=""
                android:textColor="#667085"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/r6_subj"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#121826"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/r6_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text=""
                android:textColor="#667085"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="2dp"
        android:text=""
        android:textColor="#667085"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="8dp"
        android:text=""
        android:textColor="#667085"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
